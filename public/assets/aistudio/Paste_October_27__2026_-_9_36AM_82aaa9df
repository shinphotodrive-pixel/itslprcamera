        function calculateLatencyPhysics() {
            const speedKmH = parseFloat(document.getElementById('calcSpeedInput').value) || 100;
            const speedMps = speedKmH * (1000 / 3600); // m/s

            const dist1ms = (speedMps * 0.001) * 100; // cm
            const dist50ms = (speedMps * 0.05); // meters
            const dist200ms = (speedMps * 0.20); // meters

            document.getElementById('resDist1ms').innerText = dist1ms.toFixed(2) + " cm";
            document.getElementById('resDist50ms').innerText = dist50ms.toFixed(2) + " m";
            document.getElementById('resDist200ms').innerText = dist200ms.toFixed(2) + " m";

            updateLatencyChart(speedKmH);
        }

