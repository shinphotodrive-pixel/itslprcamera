        // --- SECTION 1: LPR OPTICAL SIMULATOR LOGIC ---
        function updateSimulator() {
            const targetType = document.getElementById('simTargetType').value;
            const shutterVal = parseInt(document.getElementById('sliderShutter').value);
            const agcVal = parseInt(document.getElementById('sliderAGC').value);
            const irisVal = parseInt(document.getElementById('sliderIris').value);
            const irVal = parseInt(document.getElementById('sliderIR').value);

            // Update Labels
            const shutterTexts = ["1/30 초 (약함)", "1/150 초", "1/500 초 (권장)", "1/2000 초", "1/10000 초 (고속)"];
            const agcTexts = ["Low (-30dB Limit)", "Medium", "High (포화 위험)"];
            const irisTexts = ["F/1.4 (완전개방)", "F/2.8 (수동고정)", "F/8.0 (자동-야간)"];
            const irTexts = ["OFF / Low", "Medium (적정)", "Max (강함)"];

            document.getElementById('valShutter').innerText = shutterTexts[shutterVal - 1];
            document.getElementById('valAGC').innerText = agcTexts[agcVal - 1];
            document.getElementById('valIris').innerText = irisTexts[irisVal - 1];
            document.getElementById('valIR').innerText = irTexts[irVal - 1];

            // Render Canvas Frame
            const canvas = document.getElementById('simCanvas');
            const ctx = canvas.getContext('2d');
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;

            ctx.clearRect(0, 0, canvas.width, canvas.height);

            // Dark Night Road Background
            ctx.fillStyle = "#0f172a";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Render Simulated Plate Box
            const plateWidth = 220;
            const plateHeight = 60;
            const plateX = (canvas.width - plateWidth) / 2;
            const plateY = (canvas.height - plateHeight) / 2;

            // Calculate Optical Artifacts
            let isWhiteout = false;
            let isBlur = false;
            let ocrScore = 99.5;

            // Whiteout rule: Reflective film + High AGC/IR/Open Iris -> Whiteout
            if (targetType === "reflective" && (agcVal === 3 || irVal === 3 || irisVal === 3)) {
                isWhiteout = true;
                ocrScore -= 45;
            }
            // Blur rule: Shutter < 3 -> Motion blur
            if (shutterVal < 3) {
                isBlur = true;
                ocrScore -= (3 - shutterVal) * 25;
            }
            // Damaged plate requires SR AI
            if (targetType === "damaged") {
                ocrScore -= 10;
            }

            ocrScore = Math.max(12.5, Math.min(99.8, ocrScore));

            // Draw Plate Base
            if (isWhiteout) {
                ctx.fillStyle = "#ffffff"; // Whiteout glare
                ctx.shadowColor = "#ffffff";
                ctx.shadowBlur = 30;
            } else {
                ctx.fillStyle = targetType === "motorcycle" ? "#fef08a" : "#ffffff";
                ctx.shadowColor = "rgba(0,0,0,0.5)";
                ctx.shadowBlur = 10;
            }

            ctx.beginPath();
            ctx.roundRect(plateX, plateY, plateWidth, plateHeight, 6);
            ctx.fill();
            ctx.shadowBlur = 0; // Reset

            // Draw License Plate Text
            if (!isWhiteout) {
                ctx.fillStyle = "#0f172a";
                ctx.font = "bold 26px font-mono, sans-serif";
                ctx.textAlign = "center";
                ctx.textBaseline = "middle";

                let sampleText = "123가 4567";
                if (targetType === "motorcycle") sampleText = "서울 강남 8901";
                if (targetType === "damaged") sampleText = "건설 04-5678";

                if (isBlur) {
                    ctx.fillStyle = "rgba(15, 23, 42, 0.3)";
                    ctx.fillText(sampleText, plateX + plateWidth / 2 + 6, plateY + plateHeight / 2);
                    ctx.fillText(sampleText, plateX + plateWidth / 2 - 6, plateY + plateHeight / 2);
                }

                if (targetType === "damaged") {
                    ctx.fillStyle = "#475569"; // Faded mud noise
                    // Add noise dots
                    for (let i = 0; i < 40; i++) {
                        ctx.fillRect(plateX + Math.random() * plateWidth, plateY + Math.random() * plateHeight, 4, 4);
                    }
                }

                ctx.fillStyle = "#0f172a";
                ctx.fillText(sampleText, plateX + plateWidth / 2, plateY + plateHeight / 2);
            }

            // Update Diagnostic Stats & Badges
            document.getElementById('simScore').innerText = ocrScore.toFixed(1) + " %";
            
            const badge = document.getElementById('simStatusBadge');
            const advice = document.getElementById('simAdviceBox');
            const whiteoutEl = document.getElementById('simWhiteout');
            const blurEl = document.getElementById('simBlur');

            whiteoutEl.innerText = isWhiteout ? "심함 (화이트아웃)" : "정상 (낮음)";
            whiteoutEl.className = isWhiteout ? "text-sm font-bold text-red-600 mt-1" : "text-sm font-bold text-slate-700 mt-1";

            blurEl.innerText = isBlur ? "심함 (셔터 부족)" : "없음 (< 0.1px)";
            blurEl.className = isBlur ? "text-sm font-bold text-red-600 mt-1" : "text-sm font-bold text-slate-700 mt-1";

            if (ocrScore >= 90) {
                badge.innerText = "최적 화질 (인식 성공)";
                badge.className = "text-xs px-2.5 py-0.5 rounded-full font-bold bg-emerald-100 text-emerald-800 border border-emerald-300";
                advice.className = "p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-xs text-emerald-900 leading-relaxed";
                advice.innerHTML = "<strong><i class='fa-solid fa-circle-check text-emerald-600 mr-1'></i>광학 튜닝 조언:</strong> 현재 설정은 난반사 및 모션 블러가 통제되어 최상의 LPR 인식률을 보장합니다.";
            } else {
                badge.innerText = "인식 장애 (튜닝 필요)";
                badge.className = "text-xs px-2.5 py-0.5 rounded-full font-bold bg-red-100 text-red-800 border border-red-300";
                advice.className = "p-3 bg-red-50 border border-red-200 rounded-lg text-xs text-red-900 leading-relaxed";
                let reason = isWhiteout ? "IR/AGC 과다로 인한 난반사 포화" : "셔터 속도 부족으로 인한 모션 블러";
                advice.innerHTML = `<strong><i class='fa-solid fa-triangle-exclamation text-red-600 mr-1'></i>광학 튜닝 경고:</strong> ${reason}가 발생했습니다. P-Iris를 수동 고정하거나 셔터 속도를 1/500s 이상으로 높이세요.`;
            }
        }

