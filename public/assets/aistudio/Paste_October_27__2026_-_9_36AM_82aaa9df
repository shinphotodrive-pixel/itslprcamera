            activeBtn.classList.remove('border-transparent', 'text-slate-500');
        }

        // --- SECTION 5: CAMERA COMPARISON TABLE & CHART ---
        function renderCameraTable(data) {
            const tbody = document.getElementById('cameraTableBody');
            tbody.innerHTML = '';

            data.forEach(item => {
                const tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition";
                tr.innerHTML = `
                    <td class="p-3 font-bold text-slate-900 border-b">
                        <div>${item.vendor}</div>
                        <div class="text-xs text-emerald-700 font-mono">${item.model}</div>
                    </td>
                    <td class="p-3 border-b">${item.resolution}</td>
                    <td class="p-3 border-b">${item.lens}</td>
                    <td class="p-3 border-b">${item.irWdr}</td>
                    <td class="p-3 border-b text-[11px] text-slate-600 leading-snug">${item.aiFeatures}</td>
                    <td class="p-3 border-b">
                        <div class="font-bold text-slate-800">${item.priceText}</div>
                        <a href="${item.url}" target="_blank" class="text-[11px] text-emerald-600 hover:underline flex items-center mt-1">
                            공식 제원 / 구매 <i class="fa-solid fa-arrow-up-right-from-square text-[9px] ml-1"></i>
                        </a>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function filterCameraTable() {
            const q = document.getElementById('tableSearchInput').value.toLowerCase();
            const filtered = cameraData.filter(item => 
                item.vendor.toLowerCase().includes(q) ||
                item.model.toLowerCase().includes(q) ||
                item.aiFeatures.toLowerCase().includes(q)
            );
            renderCameraTable(filtered);
        }

        function initCompareChart() {
            const ctx = document.getElementById('cameraCompareChart').getContext('2d');
            compareChartObj = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: cameraData.map(c => c.model.split(' ')[0]),
                    datasets: [
                        {
                            label: '센서 해상도 (만 화소)',
                            data: cameraData.map(c => c.pixels),
                            backgroundColor: 'rgba(16, 185, 129, 0.8)',
                            borderColor: '#059669',
                            borderWidth: 1
                        },
                        {
                            label: 'IR 투광 가시거리 (m)',
                            data: cameraData.map(c => c.irRange),
                            backgroundColor: 'rgba(14, 165, 233, 0.8)',
                            borderColor: '#0284c7',
                            borderWidth: 1
                        },
                        {
                            label: '추정 단가 지수 (만원)',
                            data: cameraData.map(c => c.priceNum),
                            backgroundColor: 'rgba(245, 158, 11, 0.8)',
                            borderColor: '#d97706',
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top' },
                        tooltip: { mode: 'index', intersect: false }
                    },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }

        // --- SECTION 6: VIDEO GRID RENDER ---
        function renderVideoGrid(videos) {
            const grid = document.getElementById('videoGrid');
            grid.innerHTML = '';

            videos.forEach(v => {
                const card = document.createElement('div');
                card.className = "bg-white p-4 rounded-xl border border-slate-200 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-3";
                card.innerHTML = `
                    <div class="space-y-2">
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] px-2 py-0.5 rounded font-bold ${v.badgeColor}">${v.category}</span>
                            <span class="text-[11px] text-slate-400 font-semibold">${v.publisher}</span>
                        </div>
                        <h4 class="font-bold text-xs text-slate-800 leading-snug">${v.title}</h4>
                        <p class="text-[11px] text-slate-500 leading-relaxed">${v.summary}</p>
                    </div>
                    <a href="${v.url}" target="_blank" class="w-full bg-slate-900 hover:bg-slate-800 text-white text-xs py-2 px-3 rounded-lg flex items-center justify-center space-x-1 font-medium transition">
                        <i class="fa-brands fa-youtube text-red-500 mr-1.5 text-sm"></i>
                        <span>YouTube 시연 영상 재생</span>
                    </a>
                `;
                grid.appendChild(card);
            });
        }
    </script>
</body>
</html>